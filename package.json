{
  "name": "demar-alyans",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "db:generate": "npm run prisma:generate --workspace @demar/db",
    "db:migrate": "npm run prisma:migrate --workspace @demar/db"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
