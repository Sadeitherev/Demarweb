{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".gitignore"],
  "remoteCache": {
    "enabled": false
  },
  "concurrency": "50%",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
